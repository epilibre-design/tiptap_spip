<paquet
	prefix="tiptap_spip"
	categorie="edition"
	version="1.1.0"
	etat="test"
	compatibilite="[4.2.0;5.*]"
	logo="prive/themes/spip/images/tiptap-spip-xx.svg"
	documentation="https://epilibre-design.github.io/tiptap_spip/"
>
	<nom>Éditeur visuel pour SPIP</nom>
	<!-- Éditeur visuel Tiptap qui lit et écrit les raccourcis SPIP -->

	<credit lien="https://tiptap.dev">Tiptap</credit>
	<credit lien="https://remixicon.com">Remix Icon (Apache-2.0)</credit>
	<licence lien="https://spdx.org/licenses/GPL-3.0-or-later.html">GPL-3.0-or-later</licence>

	<utilise nom="porte_plume" />
	<!-- catalogue des modèles : formulaires YAML en modalbox -->
	<utilise nom="inserer_modeles" />
	<!-- coloration syntaxique des blocs de code : highlight.js et thème du plugin -->
	<utilise nom="coloration_code" />

	<pipeline nom="header_prive" inclure="tiptap_spip_pipelines.php" />
	<pipeline nom="insert_head" inclure="tiptap_spip_pipelines.php" />
	<pipeline nom="importmap" inclure="tiptap_spip_pipelines.php" />
	<pipeline nom="formulaire_fond" inclure="tiptap_spip_pipelines.php" />
	<pipeline nom="autoriser" inclure="tiptap_spip_pipelines.php" />
	<!-- pipeline propre : contextes des formulaires qui embarquent l'éditeur -->
	<pipeline nom="tiptap_spip_contextes" action="" />
	<!-- pipeline propre : barres d'outils de l'éditeur -->
	<pipeline nom="tiptap_spip_toolbars" action="" />
	<!-- pipelines propres : scripts et chaînes de langue des extensions tierces (spec 07 §3) -->
	<pipeline nom="tiptap_spip_extensions" action="" />
	<pipeline nom="tiptap_spip_i18n" action="" />

	<menu nom="configurer_tiptap_spip" titre="tiptap_spip:cfg_titre" parent="menu_configuration" icone="images/tiptap-spip-16.png"/>

	<chemin path="" />
	<chemin path="prive" />
</paquet>
